{
  "name": "radas",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestión RADAS (Dynamis): usuarios y roles, carta, insumos, recetas, costos, stock, personal y mesas",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/build-web.js && node --watch src/server.js",
    "start": "node src/server.js",
    "build": "node scripts/build-web.js",
    "build:watch": "node scripts/build-web.js --watch",
    "seed": "node scripts/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:dominio": "node --test test/dominio.test.js",
    "respaldo": "node scripts/respaldo.js"
  },
  "dependencies": {
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "esbuild": "^0.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
