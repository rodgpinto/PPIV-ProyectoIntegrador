# Todo es opcional en desarrollo: sin DATABASE_URL se usa PGlite (PostgreSQL embebido, sin instalar nada).
# En producción: ver docs/DESPLIEGUE.md

PORT=3000

# PostgreSQL real (producción, o desarrollo si ya lo tenés instalado):
# DATABASE_URL=postgres://usuario:clave@localhost:5432/radas
DB_POOL_MAX=5

# Solo para docker-compose (la clave de la base que crea Docker) y la dirección pública del sistema (docker-compose.prod.yml)
# DB_PASSWORD=una-clave-larga-y-distinta-a-la-del-admin
# DOMINIO=radas.midominio.com

# Dónde guarda PGlite sus datos en desarrollo. "memory" = no persiste nada.
PGLITE_DIR=.data/pglite

ZONA_HORARIA=America/Argentina/Buenos_Aires
# La noche comercial (ventas y caja) va de esta hora a la misma del día siguiente
JORNADA_INICIO_HORA=6
SESION_HORAS=14
# Cantidad de proxies delante de la app (0 si no hay; 1 con Caddy). Afecta al límite de intentos de login.
TRUST_PROXY=0

# Primer administrador: se crea solo al arrancar si todavía no hay ninguno.
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Copias de seguridad (docs/COPIAS.md)
# Carpeta donde se guardan (con Docker ya viene configurada en un volumen)
RESPALDO_DIR=.data/respaldos
# Cada cuántas horas se hace una copia automática. 0 = ninguna (no recomendado)
RESPALDO_CADA_HORAS=12
# Cuántos archivos se conservan; los más viejos se borran
RESPALDO_CONSERVAR=40
# Comando que se ejecuta después de cada copia para llevarla a otro lugar. {archivo} = ruta completa, {nombre} = solo el nombre.
# Ejemplo con rclone y Backblaze B2 (ver docs/COPIAS.md):
# RESPALDO_COMANDO_EXTERNO=rclone copy {archivo} b2radas:radas-copias
